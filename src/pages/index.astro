---
import AnimatedHero from "../components/AnimatedHero.astro";
import "../styles/fonts.css";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ftwo</title>
    <meta name="description" content="ftwo Digital — criatividade em movimento." />
    <meta name="theme-color" content="#000000" />
  </head>

  <body>
    <main>
      <AnimatedHero />
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    overflow-x: hidden;
    background: #000;
    color: #fff;
  }

  body {
    font-family: "Neue Montreal", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
</style>
