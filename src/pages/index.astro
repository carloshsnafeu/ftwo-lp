---
import Navbar from "../components/Navbar.astro";
import WhatsAppFlutuante from "../components/WhatsAppFlutuante.astro";
import AnimatedHero from "../components/AnimatedHero.astro";
import Problema from "../components/sections/Problema.astro";
import Manifesto from "../components/sections/Manifesto.astro";
import Servicos from "../components/sections/Servicos.astro";
import Cronograma from "../components/sections/Cronograma.astro";
import Time from "../components/sections/Time.astro";
import Planos from "../components/sections/Planos.astro";
import Contato from "../components/sections/Contato.astro";
import Rodape from "../components/sections/Rodape.astro";
import { siteData } from "../data/sitedata";

import "../styles/fonts.css";
import "../styles/tokens.css";

const { title, description, themeColor } = siteData.meta;
const url = siteData.url;
const imagemSocial = `${url}/og.jpg`;

const organizacaoId = `${url}/#organizacao`;
const siteId = `${url}/#site`;
const paginaId = `${url}/#pagina`;

/**
 * Só entra aqui o que está visível na página: nada de nota, avaliação,
 * endereço ou pessoa que o site não mostra. Por isso "employee" só aparece
 * quando siteData.time.ativo é true — a seção "Quem faz" está desligada
 * hoje, e sem ela o schema não pode falar dos nomes de ninguém.
 */
const dadosEstruturados = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizacaoId,
      name: "FTWO Digital",
      url,
      description,
      slogan: siteData.manifesto.assinatura,
      telephone: `+55${siteData.contato.whatsapp.slice(2)}`,
      email: siteData.contato.email,
      areaServed: "BR",
      knowsAbout: siteData.servicos.familias.flatMap((familia) =>
        familia.itens.map((item) => item.nome)
      ),
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: siteData.servicos.titulo,
        itemListElement: siteData.servicos.familias.map((familia) => ({
          "@type": "OfferCatalog",
          name: familia.nome,
          itemListElement: familia.itens.map((item) => ({
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: item.nome,
              description: item.resumo,
            },
          })),
        })),
      },
      ...(siteData.time.ativo && {
        employee: siteData.time.pessoas.map((pessoa) => ({
          "@type": "Person",
          name: pessoa.nome,
          jobTitle: pessoa.cargo,
        })),
      }),
    },
    {
      "@type": "WebSite",
      "@id": siteId,
      url,
      name: title,
      inLanguage: "pt-BR",
      publisher: { "@id": organizacaoId },
    },
    {
      "@type": "WebPage",
      "@id": paginaId,
      url: `${url}/`,
      name: title,
      description,
      inLanguage: "pt-BR",
      isPartOf: { "@id": siteId },
      about: { "@id": organizacaoId },
      primaryImageOfPage: imagemSocial,
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: ["h1", "#problema-titulo", "#manifesto-titulo"],
      },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={`${url}/`} />
    {!siteData.indexavel && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FTWO Digital" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${url}/`} />
    <meta property="og:image" content={imagemSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FTWO Digital" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagemSocial} />

    <script type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />

    <link
      rel="preload"
      href="/fonts/neue-montreal/NeueMontreal-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/neue-montreal/NeueMontreal-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Marca antes da primeira pintura: sem isso o conteúdo pisca visível
         antes do script de revelação assumir. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body id="topo">
    <Navbar />
    <WhatsAppFlutuante />

    <main>
      <AnimatedHero />
      <Problema />
      <Manifesto />
      <Servicos />
      <Cronograma />
      {siteData.time.ativo && <Time />}
      <Planos />
      <Contato />
    </main>

    <Rodape />
  </body>
</html>

<script>
  import { iniciarRevelacoes } from "../scripts/revelar";

  iniciarRevelacoes();
</script>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    overflow-x: hidden;
    background: var(--preto);
    color: var(--texto);
  }

  body {
    font-family: var(--fonte);
    -webkit-font-smoothing: antialiased;

    /* Tracking base para tudo que é texto pequeno — títulos e display
       sobrescrevem com valores negativos. letter-spacing é herdado e não é
       zerado pelo atalho `font`, então esta linha alcança o site inteiro. */
    letter-spacing: 0.014em;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
