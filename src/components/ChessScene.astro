---
interface Props {
  src?: string;
}

const { src = `${import.meta.env.BASE_URL}models/ftwo_chess_animated.glb` } = Astro.props;
---

<div class="palco" data-src={src} aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .palco {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 260px;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";

  const palco = document.querySelector<HTMLElement>(".palco");
  const canvas = palco?.querySelector("canvas");
  if (palco && canvas) montarCena(palco, canvas);

  function montarCena(palco: HTMLElement, canvas: HTMLCanvasElement) {
    const reduzirMovimento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const cena = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.01, 100);

    const renderizador = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderizador.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderizador.outputColorSpace = THREE.SRGBColorSpace;
    renderizador.toneMapping = THREE.ACESFilmicToneMapping;
    renderizador.toneMappingExposure = 1.15;

    cena.add(new THREE.HemisphereLight(0xffffff, 0x151515, 2.2));

    const luzPrincipal = new THREE.DirectionalLight(0xffffff, 4);
    luzPrincipal.position.set(-5, -4, 8);
    cena.add(luzPrincipal);

    const luzDeContorno = new THREE.DirectionalLight(0xff7a45, 3.2);
    luzDeContorno.position.set(6, 3, 4);
    cena.add(luzDeContorno);

    function redimensionar() {
      const largura = palco.clientWidth || 1;
      const altura = palco.clientHeight || 1;
      renderizador.setSize(largura, altura, false);
      camera.aspect = largura / altura;
      camera.updateProjectionMatrix();
      renderizador.render(cena, camera);
    }

    new ResizeObserver(redimensionar).observe(palco);
    redimensionar();

    let mixer: THREE.AnimationMixer | null = null;

    function enquadrar(objeto: THREE.Object3D) {
      const caixa = new THREE.Box3().setFromObject(objeto);
      const esfera = caixa.getBoundingSphere(new THREE.Sphere());
      const distancia = esfera.radius / Math.sin(THREE.MathUtils.degToRad(camera.fov / 2));

      camera.position.set(esfera.center.x, esfera.center.y, esfera.center.z + distancia * 0.88);
      camera.lookAt(esfera.center);
      camera.near = Math.max(distancia / 100, 0.01);
      camera.far = distancia * 100;
      camera.updateProjectionMatrix();
    }

    new GLTFLoader().load(palco.dataset.src!, (gltf) => {
      const modelo = gltf.scene;
      cena.add(modelo);
      enquadrar(modelo);

      if (gltf.animations.length && !reduzirMovimento) {
        mixer = new THREE.AnimationMixer(modelo);
        gltf.animations.forEach((clipe) => mixer!.clipAction(clipe).play());
      }

      renderizador.render(cena, camera);
    });

    // Só gira enquanto está à vista: fora da tela não há o que observar, e um
    // loop de render invisível só gasta bateria.
    const relogio = new THREE.Clock();
    let visivel = false;
    let quadro = 0;

    function girar() {
      quadro = requestAnimationFrame(girar);
      if (mixer) mixer.update(relogio.getDelta());
      renderizador.render(cena, camera);
    }

    new IntersectionObserver((entradas) => {
      const aparece = entradas[0].isIntersecting;
      if (aparece === visivel) return;
      visivel = aparece;

      if (visivel && !reduzirMovimento) {
        relogio.getDelta();
        girar();
      } else {
        cancelAnimationFrame(quadro);
      }
    }).observe(palco);
  }
</script>
