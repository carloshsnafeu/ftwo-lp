---
import { siteData } from "../data/sitedata";

const { whatsapp, mensagemFlutuante } = siteData.contato;
const link = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensagemFlutuante)}`;
---

<a class="whats" href={link} target="_blank" rel="noopener" aria-label="Conversar no WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.17c-.24.68-1.4 1.33-1.93 1.4-.5.08-1.11.11-1.79-.11a16.2 16.2 0 0 1-1.63-.6c-2.88-1.24-4.76-4.13-4.9-4.32-.14-.19-1.17-1.56-1.17-2.98 0-1.42.74-2.11 1-2.4.26-.29.57-.36.76-.36l.55.01c.17.01.41-.07.64.49.24.58.81 2 .88 2.14.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.15-.3.3-.13.6.17.29.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.35 1.46.29.15.46.13.63-.05.17-.19.72-.84.92-1.13.19-.29.38-.24.64-.14.26.1 1.66.78 1.94.92.29.14.48.21.55.33.07.12.07.68-.17 1.36Z"
    />
  </svg>
</a>

<style>
  .whats {
    position: fixed;
    z-index: 55;
    left: clamp(16px, 3vw, 28px);
    bottom: clamp(16px, 3vh, 28px);

    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;

    background: rgba(10, 10, 10, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 34px -14px rgba(0, 0, 0, 0.7);

    color: #25d366;
    text-decoration: none;

    transition: transform 0.16s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .whats:hover {
    transform: translateY(-3px);
    border-color: rgba(37, 211, 102, 0.55);
    box-shadow: 0 20px 40px -14px rgba(37, 211, 102, 0.35);
  }

  /* Feedback no toque, não na soltura. */
  .whats:active {
    transform: scale(0.94);
  }

  @media (max-width: 600px) {
    .whats {
      width: 50px;
      height: 50px;
    }

    .whats svg {
      width: 23px;
      height: 23px;
    }
  }
</style>
