---
import { siteData } from "../data/sitedata";

const { pecas } = siteData.hero;
---

<div class="pieces" aria-label="Peças criadas pela ftwo" data-revelar-grupo>
  {
    pecas.map((peca) => (
      <img
        class={`piece piece--${peca.id}`}
        src={peca.src}
        alt={peca.alt}
        width={peca.w}
        height={peca.h}
        loading="lazy"
        decoding="async"
        data-revelar
      />
    ))
  }
</div>

<style>
  /* Preenche a coluna da grade que a recebe; a proporção interna é quem
     mantém a composição das peças sobrepostas. */
  .pieces {
    position: relative;
    width: 100%;
    aspect-ratio: 1.02;

    pointer-events: none;
  }

  .piece {
    position: absolute;
    display: block;
    height: auto;

    /* Sombra funda separa as peças do fundo atrás. */
    filter: drop-shadow(0 18px 38px rgba(0, 0, 0, 0.45));
  }

  /* As peças se sobrepõem: a ordem no DOM define quem fica por cima. */

  .piece--banner {
    left: 15%;
    top: 2%;
    width: 70%;
  }

  /* Nasce atrás do tubo: só o crachá aparece por baixo, como se estivesse
     pendurado na peça, em vez de flutuar solto. */
  .piece--cracha {
    left: 76%;
    top: 39%;
    width: 11%;
  }

  .piece--tubo {
    left: 69%;
    top: 37%;
    width: 29%;
  }

  .piece--camisa {
    left: 26%;
    top: 40%;
    width: 40%;
  }

  /* Centralizado logo abaixo da camisa, encostando na barra dela. */
  .piece--sobreira {
    left: 30%;
    top: 72%;
    width: 32%;
  }

  @media (max-width: 900px) {
    .pieces {
      max-width: 460px;
      margin-inline: auto;
    }
  }
</style>
