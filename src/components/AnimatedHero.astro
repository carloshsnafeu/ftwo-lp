---
import logoSvg from "../../public/ftwo-logo.svg?raw";
import { siteData } from "../data/sitedata";

const { logoAlt, welcome } = siteData.hero;
---

<section class="hero" aria-label={logoAlt}>
  <div class="background" aria-hidden="true">
    <div class="blob blob-red-left"></div>
    <div class="blob blob-orange-bottom"></div>
    <div class="blob blob-red-right"></div>
    <div class="blob blob-blue"></div>
    <div class="blob blob-black"></div>
  </div>
  <div class="noise" aria-hidden="true"></div>

  <div class="content" id="hero-content">
    <div class="intro" id="hero-intro">
      <h1 class="brand">
        <span class="logo" id="ftwo-logo" role="img" aria-label={logoAlt} set:html={logoSvg} />
      </h1>
      <p class="welcome" id="hero-welcome">
        {welcome.map((line) => <span class="welcome-line">{line}</span>)}
      </p>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";

  const content = document.querySelector<HTMLElement>("#hero-content");
  const intro = document.querySelector<HTMLElement>("#hero-intro");
  const welcome = document.querySelector<HTMLElement>("#hero-welcome");
  const logo = document.querySelector<HTMLElement>("#ftwo-logo");
  const paths = logo ? Array.from(logo.querySelectorAll("path")) : [];

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Ritmo da intro. Aumentar estes valores deixa a construção mais lenta.
  const STAGGER = 110;
  const DRAW_MS = 1800;
  const FILL_DELAY = 350;
  const FILL_MS = 900;

  // visualDuration é o tempo de movimento visível — equivale ao "response" da Apple.
  const SETTLE_SPRING = { type: "spring", bounce: 0, visualDuration: 1.1 } as const;
  const WELCOME_SPRING = { type: "spring", bounce: 0, visualDuration: 0.9, delay: 0.5 } as const;

  function drawLogo() {
    paths.forEach((path, index) => {
      const length = path.getTotalLength();

      // Sem transição enquanto o estado inicial é aplicado, senão o navegador
      // pode resolver tudo de uma vez e a logo aparece pronta, sem se desenhar.
      path.style.transition = "none";
      path.style.fill = "transparent";
      path.style.stroke = "#fff";
      path.style.strokeWidth = "1.4";
      path.style.strokeOpacity = "1";
      path.style.strokeDasharray = String(length);
      path.style.strokeDashoffset = String(length);
      path.getBoundingClientRect();

      path.style.transition = [
        `stroke-dashoffset ${DRAW_MS}ms cubic-bezier(.65,0,.35,1) ${index * STAGGER}ms`,
        `fill ${FILL_MS}ms ease ${DRAW_MS + index * STAGGER + FILL_DELAY}ms`,
        `stroke-opacity ${FILL_MS}ms ease ${DRAW_MS + index * STAGGER + FILL_DELAY}ms`,
      ].join(", ");
    });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        paths.forEach((path) => {
          path.style.strokeDashoffset = "0";
          path.style.fill = "#fff";
          path.style.strokeOpacity = "0";
        });
      });
    });
  }

  /**
   * FLIP: the left-aligned position is defined by CSS, so the layout stays
   * correct on resize; only the transform is animated, from the measured
   * center position back to zero.
   */
  function settleToLeft() {
    if (!content || !intro || !welcome) return;

    const first = intro.getBoundingClientRect().left;
    content.classList.add("is-settled");
    const last = intro.getBoundingClientRect().left;

    // Aplica o deslocamento antes de animar: a mola parte do valor que está
    // na tela, então pode ser interrompida ou redirecionada sem salto.
    intro.style.transform = `translateX(${first - last}px)`;

    // A marca encolhe e o bloco sobe para abrir espaço à headline embaixo.
    const settledScale =
      parseFloat(getComputedStyle(intro).getPropertyValue("--logo-settled-scale")) || 0.66;
    const lift = -Math.round(window.innerHeight * 0.07);

    if (logo) animate(logo, { scale: settledScale }, SETTLE_SPRING);
    animate(intro, { x: 0, y: lift }, SETTLE_SPRING);
    animate(welcome, { opacity: [0, 1], y: [14, 0] }, WELCOME_SPRING);
  }

  if (content && intro && welcome && paths.length) {
    if (reduceMotion) {
      content.classList.add("is-settled");
      welcome.style.opacity = "1";
    } else {
      const drawTotal = DRAW_MS + (paths.length - 1) * STAGGER + FILL_DELAY + FILL_MS;
      drawLogo();
      setTimeout(settleToLeft, drawTotal);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;

    overflow: hidden;
    background: #000;
    isolation: isolate;
  }

  /* ==============================
     FUNDO / BLOBS
  ============================== */

  .background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse at 45% 25%,
        #161616 0%,
        #111 35%,
        #080808 75%
      );
  }

  .blob {
    position: absolute;
    will-change: transform;
    pointer-events: none;
  }

  /* VERMELHO / LARANJA ESQUERDA */

  .blob-red-left {
    width: 75vw;
    height: 68vw;

    left: -28vw;
    top: 25vh;

    border-radius: 44% 56% 63% 37% / 54% 43% 57% 46%;

    background:
      radial-gradient(
        circle at 62% 45%,
        #ffac43 0%,
        #ff6b32 20%,
        #fb3028 42%,
        #b60613 64%,
        transparent 76%
      );

    filter: blur(17px);

    animation: moveLeft 12s ease-in-out -3.5s infinite alternate;
  }

  /* LARANJA INFERIOR */

  .blob-orange-bottom {
    width: 120vw;
    height: 48vw;

    left: -10vw;
    bottom: -18vw;

    border-radius: 50%;

    background:
      radial-gradient(
        ellipse,
        #ffc260 0%,
        #ff9144 28%,
        #f64a2c 48%,
        #bc111b 65%,
        transparent 76%
      );

    filter: blur(22px);

    animation: moveBottom 16s ease-in-out -6.5s infinite alternate;
  }

  /* VERMELHO DIREITA */

  .blob-red-right {
    width: 63vw;
    height: 55vw;

    right: -29vw;
    top: 3vh;

    border-radius: 53% 47% 40% 60% / 47% 53% 47% 53%;

    background:
      radial-gradient(
        ellipse at 35% 48%,
        #ff9744 0%,
        #ff5130 24%,
        #ed2027 43%,
        #9c0712 65%,
        transparent 78%
      );

    filter: blur(19px);

    animation: moveRight 14s ease-in-out -5.5s infinite alternate;
  }

  /* AZUL / VERDE INFERIOR */

  .blob-blue {
    width: 67vw;
    height: 35vw;

    left: 12vw;
    bottom: -9vw;

    border-radius: 50%;

    background:
      radial-gradient(
        ellipse,
        #5e9297 0%,
        #507f86 30%,
        #265f69 52%,
        transparent 75%
      );

    filter: blur(25px);

    animation: moveBlue 19s ease-in-out -9.5s infinite alternate;
  }

  /* MANCHA PRETA CENTRAL */

  .blob-black {
    width: 82vw;
    height: 45vw;

    left: 25vw;
    top: 19vh;

    border-radius:
      46% 54% 43% 57%
      /
      48% 39% 61% 52%;

    background:
      radial-gradient(
        ellipse at center,
        #111 0%,
        #101010 50%,
        #171717 68%,
        transparent 73%
      );

    filter: blur(10px);

    animation: moveBlack 21s ease-in-out -2.5s infinite alternate;
  }

  /* ==============================
     TEXTURA / GRÃO
  ============================== */

  .noise {
    position: absolute;
    inset: 0;

    z-index: 1;

    pointer-events: none;

    opacity: 0.24;

    mix-blend-mode: soft-light;

    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='1'/%3E%3C/svg%3E");

    /* Static tiled grain: no per-frame noise rendering or full-screen repaint. */
    background-size: 180px 180px;
    background-repeat: repeat;
  }

  /* ==============================
     CONTEÚDO
  ============================== */

  .content {
    position: relative;

    z-index: 2;

    width: 100%;
    height: 100%;

    display: flex;
    justify-content: center;
    align-items: center;

    padding-inline: clamp(24px, 6vw, 80px);
  }

  .content.is-settled {
    justify-content: flex-start;
  }

  .intro {
    position: relative;

    /* Fator único: a headline se posiciona a partir da logo já reduzida. */
    --logo-settled-scale: 0.66;
  }

  /* Absolute so the hidden text doesn't offset the logo while it's centered,
     e para que o texto possa cavalgar sobre a marca. */
  .welcome {
    position: absolute;
    /* Logo abaixo da marca já reduzida — o transform não altera o layout,
       então a altura vem do fator de escala. */
    top: calc(100% * var(--logo-settled-scale) + clamp(12px, 1.5vw, 24px));
    left: 0;

    z-index: 1;

    margin: 0;

    /* O bloco é posicionado dentro da logo; sem isso herdaria a largura dela
       e quebraria as linhas em pedaços. */
    width: max-content;

    font-size: clamp(38px, 7.4vw, 108px);
    font-weight: 700;
    /* Texto de display pede entrelinha curta e tracking negativo. */
    line-height: 0.92;
    letter-spacing: -0.038em;

    color: #fff;

    /* Sombra funda dá a separação sobre a marca sem precisar apagá-la. */
    text-shadow:
      0 2px 10px rgba(0, 0, 0, 0.5),
      0 6px 40px rgba(0, 0, 0, 0.6);

    opacity: 0;
  }

  .welcome-line {
    display: block;
    white-space: nowrap;
  }

  .logo {
    display: block;

    width: clamp(210px, 32vw, 380px);
    max-width: 80vw;

    /* Ancorada na quina: reduzir não desloca a borda esquerda, então a
       medição do FLIP continua válida. */
    transform-origin: left top;
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .logo :global(path) {
    fill: #fff;
  }

  .brand {
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  /* Non-uniform scaling deforms the shapes without animating blur or layout. */
  @keyframes moveLeft {
    0% {
      transform:
        translate3d(0, 0, 0)
        rotate(-4deg)
        scale(1);
    }

    50% {
      transform:
        translate3d(6vw, -5vh, 0)
        rotate(4deg)
        scale(1.12, 0.91);
    }

    100% {
      transform:
        translate3d(-3vw, 4vh, 0)
        rotate(-1deg)
        scale(0.96);
    }
  }

  @keyframes moveRight {
    0% {
      transform:
        translate3d(0, 0, 0)
        rotate(4deg)
        scale(1);
    }

    50% {
      transform:
        translate3d(-9vw, 5vh, 0)
        rotate(-3deg)
        scale(0.94, 1.16);
    }

    100% {
      transform:
        translate3d(2vw, -4vh, 0)
        rotate(3deg)
        scale(0.98);
    }
  }

  @keyframes moveBottom {
    0% {
      transform:
        translate3d(0, 0, 0)
        scale(1);
    }

    50% {
      transform:
        translate3d(4vw, -5vh, 0)
        scale(1.15, 0.89);
    }

    100% {
      transform:
        translate3d(-5vw, 1vh, 0)
        scale(0.96, 1.09);
    }
  }

  @keyframes moveBlue {
    0% {
      transform:
        translate3d(0, 0, 0)
        scale(1);
    }

    50% {
      transform:
        translate3d(-8vw, -4vh, 0)
        scale(1.15, 0.89);
    }

    100% {
      transform:
        translate3d(5vw, 2vh, 0)
        scale(0.98);
    }
  }

  @keyframes moveBlack {
    0% {
      transform:
        translate3d(0, 0, 0)
        rotate(0deg)
        scale(1);
    }

    50% {
      transform:
        translate3d(-6vw, 2vh, 0)
        rotate(-2deg)
        scale(0.96, 1.09);
    }

    100% {
      transform:
        translate3d(4vw, -3vh, 0)
        rotate(2deg)
        scale(0.96);
    }
  }

  /* Viewport-relative height keeps color visible on tall mobile screens. */
  @media (max-width: 768px) {
    .blob-red-left {
      width: 140vw;
      height: 80%;
      left: -75vw;
      top: 18%;
    }

    .blob-red-right {
      width: 130vw;
      height: 70%;
      right: -72vw;
      top: -12%;
    }

    .blob-orange-bottom {
      width: 180vw;
      height: 55%;
      left: -35vw;
      bottom: -22%;
    }

    .blob-blue {
      width: 145vw;
      height: 45%;
      left: -12vw;
      bottom: -12%;
    }

    .blob-black {
      width: 155vw;
      height: 60%;
      left: 0;
      top: 15%;
    }

    .blob {
      filter: blur(16px);
    }

    .logo {
      width: min(290px, 72vw);
    }

    .welcome {
      font-size: clamp(34px, 12vw, 54px);
    }
  }

  /* acessibilidade */

  @media (prefers-reduced-motion: reduce) {
    .blob,
    .noise {
      animation: none;
      will-change: auto;
    }
  }
</style>
