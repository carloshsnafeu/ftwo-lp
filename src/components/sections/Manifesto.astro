---
import logoSvg from "../../../public/ftwo-logo.svg?raw";
import { siteData } from "../../data/sitedata";

const { logoAlt } = siteData.hero;
const { etiqueta, texto, assinatura, assinaturaApoio } = siteData.manifesto;
---

<section class="manifesto secao grao" id="manifesto" aria-labelledby="manifesto-titulo">
  <div class="brilho" aria-hidden="true"></div>

  <div class="container grade">
    <div class="texto" id="manifesto-texto" data-revelar-grupo>
      <p class="etiqueta" data-revelar>{etiqueta}</p>

      <h2 class="declaracao" id="manifesto-titulo" data-revelar>
        {texto.map((trecho) => <span class={`trecho trecho--${trecho.enfase}`}>{trecho.valor}</span>)}
      </h2>

      <div class="carimbo" data-revelar>
        <span class="carimbo-barra" aria-hidden="true"></span>
        <p class="carimbo-texto">
          <strong class="assinatura">{assinatura}</strong>
          <span class="assinatura-apoio">{assinaturaApoio}</span>
        </p>
      </div>
    </div>

    <div class="marca-coluna">
      <span class="marca-desenho" id="manifesto-logo" role="img" aria-label={logoAlt} set:html={logoSvg} />
    </div>
  </div>
</section>

<script>
  /**
   * A logo se desenha aqui agora (antes ficava na intro). O gatilho é o
   * mesmo elemento e limiar que o revelar.ts usa para o resto do bloco, para
   * as duas animações nascerem juntas em vez de destoar uma da outra.
   */
  const gatilho = document.querySelector<HTMLElement>("#manifesto-texto");
  const logo = document.querySelector<HTMLElement>("#manifesto-logo");
  const paths = logo ? Array.from(logo.querySelectorAll("path")) : [];

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const STAGGER = 90;
  const DRAW_MS = 1400;
  const FILL_DELAY = 260;
  const FILL_MS = 700;

  function drawLogo() {
    paths.forEach((path, index) => {
      const length = path.getTotalLength();

      path.style.transition = "none";
      path.style.fill = "transparent";
      path.style.stroke = "#fff";
      path.style.strokeWidth = "1.4";
      path.style.strokeOpacity = "1";
      path.style.strokeDasharray = String(length);
      path.style.strokeDashoffset = String(length);
      path.getBoundingClientRect();

      path.style.transition = [
        `stroke-dashoffset ${DRAW_MS}ms cubic-bezier(.65,0,.35,1) ${index * STAGGER}ms`,
        `fill ${FILL_MS}ms ease ${DRAW_MS + index * STAGGER + FILL_DELAY}ms`,
        `stroke-opacity ${FILL_MS}ms ease ${DRAW_MS + index * STAGGER + FILL_DELAY}ms`,
      ].join(", ");
    });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        paths.forEach((path) => {
          path.style.strokeDashoffset = "0";
          path.style.fill = "#fff";
          path.style.strokeOpacity = "0";
        });
      });
    });
  }

  if (gatilho && logo && paths.length && !reduceMotion) {
    new IntersectionObserver(
      ([entrada], observador) => {
        if (!entrada.isIntersecting) return;
        observador.disconnect();
        drawLogo();
      },
      { threshold: 0.2, rootMargin: "0px 0px -8% 0px" }
    ).observe(gatilho);
  }
</script>

<style>
  /* Cabe numa tela só, como a intro: a hierarquia por peso/cor já carrega o
     impacto, então o tamanho pôde encolher sem perder força. */
  .manifesto {
    min-height: 100svh;

    display: flex;
    align-items: center;

    padding-block: clamp(64px, 9vh, 110px);

    background: var(--preto);
    overflow: hidden;
  }

  /* O gradiente da intro volta aqui, mas rebaixado: presença, não protagonismo. */
  .brilho {
    position: absolute;
    z-index: 0;
    inset: -30% -10% auto;
    height: 130%;

    background: radial-gradient(
      ellipse at 30% 40%,
      rgba(237, 32, 39, 0.24) 0%,
      rgba(255, 107, 50, 0.12) 32%,
      transparent 62%
    );

    filter: blur(28px);
    pointer-events: none;
  }

  .grade {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .texto {
    position: relative;
  }

  /* A marca ocupa o espaço onde antes ficava a colagem de peças. */
  .marca-coluna {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .marca-desenho {
    display: block;
    width: clamp(240px, 30vw, 440px);
  }

  .marca-desenho :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .marca-desenho :global(path) {
    fill: #fff;
  }

  .declaracao {
    margin: clamp(12px, 1.6vw, 18px) 0 0;
    max-width: 44ch;

    font-family: var(--fonte);
    font-size: clamp(19px, 2.3vw, 31px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .trecho--conectivo {
    color: var(--texto-fraco);
    font-weight: 400;
  }

  .trecho--forte {
    color: var(--branco);
    font-weight: 700;
  }

  .trecho--destaque {
    font-weight: 800;

    background: var(--brasa);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* O "carimbo": a assinatura vira o fechamento com peso próprio, não só uma
     linha vermelha a mais no fim do parágrafo. */
  .carimbo {
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 1.6vw, 20px);

    margin-top: clamp(22px, 3vw, 36px);
  }

  .carimbo-barra {
    flex: none;
    align-self: stretch;
    width: 3px;
    border-radius: 999px;
    background: var(--brasa);
  }

  .carimbo-texto {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 14px;
    row-gap: 6px;
  }

  .assinatura {
    font-family: var(--fonte);
    font-size: clamp(19px, 2.1vw, 26px);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--branco);
  }

  .assinatura-apoio {
    font: var(--corpo);
    color: var(--texto-suave);
  }

  @media (max-width: 900px) {
    .grade {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .declaracao {
      max-width: 100%;
    }

    .marca-desenho {
      width: min(220px, 58vw);
    }
  }
</style>
