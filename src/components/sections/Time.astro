---
import { siteData } from "../../data/sitedata";

const { etiqueta, titulo, pessoas } = siteData.time;
---

<section class="time secao grao" id="time" aria-labelledby="time-titulo">
  <div class="container">
    <header class="abertura" data-revelar-grupo>
      <p class="etiqueta" data-revelar>{etiqueta}</p>
      <h2 class="titulo-secao" data-revelar id="time-titulo">{titulo}</h2>
    </header>

    <div class="pessoas" data-revelar-grupo>
      {
        pessoas.map((pessoa) => (
          <article class="pessoa" data-revelar>
            <img
              class="retrato"
              src={pessoa.foto}
              alt={pessoa.nome}
              width={pessoa.fotoW}
              height={pessoa.fotoH}
              loading="lazy"
              decoding="async"
            />

            <div class="pessoa-texto">
              {pessoa.bio.map((paragrafo) => (
                <p class="bio">{paragrafo}</p>
              ))}

              <h3 class="nome">{pessoa.nome}</h3>
              <p class="cargo">{pessoa.cargo}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .time {
    background: var(--preto-carvao);
  }

  .container {
    position: relative;
    z-index: 1;
  }

  .titulo-secao {
    margin-top: 16px;
  }

  .pessoas {
    display: grid;
    gap: clamp(20px, 2.4vw, 32px);
    margin-top: clamp(38px, 5vw, 60px);
  }

  .pessoa {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 44px);

    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--borda);
    border-radius: var(--raio-g);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.012));
  }

  /* Alterna o lado do retrato, como na apresentação. */
  .pessoa:nth-child(even) {
    flex-direction: row-reverse;
  }

  .retrato {
    flex: none;
    width: clamp(120px, 15vw, 190px);
    height: auto;
    border-radius: 50%;
    box-shadow: var(--sombra-flutuante);
  }

  .bio {
    margin: 0 0 12px;
    font: var(--corpo);
    color: var(--texto);
    text-wrap: pretty;
  }

  .nome {
    margin: 20px 0 0;
    font: 700 clamp(18px, 1.5vw, 21px) / 1.2 var(--fonte);
    letter-spacing: -0.015em;
    color: var(--vermelho);
  }

  .cargo {
    margin: 5px 0 0;
    font: 400 13px / 1.3 var(--fonte);
    letter-spacing: 0.03em;
    color: var(--texto-fraco);
  }

  @media (max-width: 760px) {
    .pessoa,
    .pessoa:nth-child(even) {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
