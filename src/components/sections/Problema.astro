---
import { siteData } from "../../data/sitedata";

const { etiqueta, dado, destaque, apoio } = siteData.problema;
---

<section class="problema secao grao" id="problema" aria-labelledby="problema-titulo">
  <img
    class="aperto"
    src="/mockups/aperto-de-mao.webp"
    alt=""
    width="1400"
    height="736"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />

  <div class="container texto" data-revelar-grupo>
    <p class="etiqueta" data-revelar>{etiqueta}</p>

    <h2 class="dado" id="problema-titulo" data-revelar>
      {dado.map((linha) => <span class="linha">{linha}</span>)}
    </h2>

    <p class="destaque" data-revelar>{destaque}</p>
    <p class="texto-apoio apoio" data-revelar>{apoio}</p>
  </div>
</section>

<style>
  .problema {
    background: var(--preto);
    overflow: hidden;
  }

  /* Fundo da seção: sangra pela direita e fica atrás do texto. */
  .aperto {
    position: absolute;
    z-index: 0;

    right: -10%;
    top: 50%;
    transform: translateY(-50%);

    width: min(62%, 900px);
    height: auto;

    opacity: 0.22;
    pointer-events: none;
    user-select: none;

    /* Some no canto esquerdo, onde o texto passa por cima. */
    mask-image: linear-gradient(to right, transparent, #000 34%);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 34%);
  }

  /* Mantém a largura do container para alinhar com as outras seções; quem
     limita a linha é cada bloco de texto. */
  .texto {
    position: relative;
    z-index: 1;
  }

  .dado {
    margin: 18px 0 0;
    max-width: 13ch;

    font: var(--display);
    letter-spacing: var(--display-track);
    color: var(--branco);
  }

  .linha {
    display: block;
  }

  .destaque {
    margin: clamp(20px, 2.6vw, 34px) 0 0;
    max-width: 30ch;
    font: var(--subtitulo);
    letter-spacing: var(--subtitulo-track);
    color: var(--vermelho);
    text-wrap: balance;
  }

  .apoio {
    margin-top: clamp(16px, 1.8vw, 24px);
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    /* Em tela estreita a mão passaria por trás do texto e sujaria a leitura. */
    .aperto {
      right: -22%;
      top: auto;
      bottom: 4%;
      transform: none;

      width: 120%;
      opacity: 0.18;
    }

    .dado,
    .destaque {
      max-width: 100%;
    }
  }
</style>
