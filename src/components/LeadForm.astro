---
interface Props {
  whatsapp?: string;
}

const { whatsapp = "5527999916296" } = Astro.props;
---

<div class="lead-card" id="lead-card">
  <p class="eyebrow">Reagir é futuro</p>
  <h2 class="title">Vamos estruturar <span>o crescimento</span> da sua empresa</h2>
  <p class="subtitle">
    Preencha seus dados e fale agora com a FTWO. Sem compromisso, sem enrolação.
  </p>

  <form id="lead-form" class="lead-form" novalidate>
    <label class="field">
      <span>Nome</span>
      <input type="text" name="nome" placeholder="Seu nome completo" autocomplete="name" required />
    </label>

    <label class="field">
      <span>Telefone</span>
      <input
        type="tel"
        name="telefone"
        placeholder="(00) 00000-0000"
        autocomplete="tel"
        inputmode="numeric"
        maxlength="15"
        required
      />
    </label>

    <label class="field">
      <span>E-mail</span>
      <input type="email" name="email" placeholder="voce@empresa.com" autocomplete="email" required />
    </label>

    <label class="field">
      <span>CNPJ</span>
      <input
        type="text"
        name="cnpj"
        placeholder="00.000.000/0000-00"
        inputmode="numeric"
        maxlength="18"
        required
      />
    </label>

    <button type="submit" class="submit">
      Falar com a FTWO agora
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <p class="disclaimer">Ao enviar, você será direcionado ao WhatsApp da FTWO com seus dados preenchidos.</p>
  </form>
</div>

<style>
  .lead-card {
    position: relative;
    width: 100%;
    max-width: 420px;

    padding: 34px 30px 28px;
    border-radius: 22px;

    background: linear-gradient(180deg, rgba(20, 20, 20, 0.72), rgba(8, 8, 8, 0.82));
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset;

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff5130;
  }

  .title {
    margin: 0 0 10px;
    font-family: inherit;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.18;
    font-weight: 700;
    color: #fff;
  }

  .title span {
    background: linear-gradient(90deg, #ffac43, #ff5130);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .subtitle {
    margin: 0 0 22px;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.6);
  }

  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .field span {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .field input {
    appearance: none;
    width: 100%;

    padding: 13px 14px;
    border-radius: 11px;

    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;

    font-size: 14.5px;
    font-family: inherit;

    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .field input::placeholder {
    color: rgba(255, 255, 255, 0.28);
  }

  .field input:focus {
    outline: none;
    border-color: #ff5130;
    background: rgba(255, 81, 48, 0.07);
  }

  .field input:invalid:not(:placeholder-shown) {
    border-color: rgba(255, 90, 90, 0.55);
  }

  .submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    margin-top: 6px;
    padding: 15px 20px;
    border: none;
    border-radius: 12px;

    background: linear-gradient(95deg, #ff6b32, #ed2027);
    color: #fff;

    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;

    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    box-shadow: 0 14px 30px -10px rgba(237, 32, 39, 0.55);
  }

  .submit svg {
    transition: transform 0.18s ease;
  }

  .submit:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
    box-shadow: 0 18px 36px -10px rgba(237, 32, 39, 0.65);
  }

  .submit:hover svg {
    transform: translateX(3px);
  }

  .submit:active {
    transform: translateY(0);
  }

  .disclaimer {
    margin: 4px 0 0;
    font-size: 11.5px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.35);
    text-align: center;
  }

  @media (max-width: 768px) {
    .lead-card {
      max-width: 100%;
      padding: 28px 22px 24px;
      border-radius: 18px;
    }
  }
</style>

<script define:vars={{ whatsapp }}>
  const form = document.querySelector("#lead-form");

  const phoneInput = form.querySelector('input[name="telefone"]');
  phoneInput.addEventListener("input", () => {
    let digits = phoneInput.value.replace(/\D/g, "").slice(0, 11);
    if (digits.length > 6) {
      digits = digits.replace(/^(\d{2})(\d{5})(\d{0,4}).*/, "($1) $2-$3");
    } else if (digits.length > 2) {
      digits = digits.replace(/^(\d{2})(\d{0,5}).*/, "($1) $2");
    } else if (digits.length > 0) {
      digits = digits.replace(/^(\d{0,2}).*/, "($1");
    }
    phoneInput.value = digits;
  });

  const cnpjInput = form.querySelector('input[name="cnpj"]');
  cnpjInput.addEventListener("input", () => {
    let digits = cnpjInput.value.replace(/\D/g, "").slice(0, 14);
    digits = digits
      .replace(/^(\d{2})(\d)/, "$1.$2")
      .replace(/^(\d{2})\.(\d{3})(\d)/, "$1.$2.$3")
      .replace(/\.(\d{3})(\d)/, ".$1/$2")
      .replace(/(\d{4})(\d)/, "$1-$2");
    cnpjInput.value = digits;
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const nome = data.get("nome")?.toString().trim() ?? "";
    const telefone = data.get("telefone")?.toString().trim() ?? "";
    const email = data.get("email")?.toString().trim() ?? "";
    const cnpj = data.get("cnpj")?.toString().trim() ?? "";

    const message =
      `Olá! Quero estruturar meu negócio com a FTWO.\n\n` +
      `Nome: ${nome}\n` +
      `Telefone: ${telefone}\n` +
      `E-mail: ${email}\n` +
      `CNPJ: ${cnpj}`;

    const url = `https://wa.me/${whatsapp}?text=${encodeURIComponent(message)}`;
    window.open(url, "_blank", "noopener");
  });
</script>
